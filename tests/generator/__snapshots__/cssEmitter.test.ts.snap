// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emitCss > matches snapshot 1`] = `
"*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  line-height: 1.5;
}

img,
picture {
  display: block;
  max-width: 100%;
}

button,
input,
select,
textarea {
  font: inherit;
}

.dtw-canvas {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
}

.dtw-el-header-1 {
  grid-column: 1 / span 12;
  min-height: 80px;
  background-color: #1a1a2e;
}

.dtw-el-h1-1 {
  grid-column: 2 / span 10;
  min-height: 60px;
  margin-top: 100px;
  color: #333333;
  font-size: clamp(27px, 2.250rem + 1vw, 45px);
}

.dtw-el-img-1 {
  grid-column: 1 / span 6;
  min-height: 300px;
  margin-top: 200px;
}

.dtw-el-btn-1 {
  grid-column: 2 / span 2;
  min-height: 48px;
  margin-top: 540px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.5em 1em;
  border: none;
  cursor: pointer;
  background-color: #0066ff;
  color: #ffffff;
  border-radius: 4px;
}

.dtw-el-footer-1 {
  grid-column: 1 / span 12;
  min-height: 80px;
  margin-top: 620px;
  background-color: #111111;
}"
`;
