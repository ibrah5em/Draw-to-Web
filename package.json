{
  "name": "draw-to-web",
  "version": "0.1.0",
  "description": "Convert visual canvas layouts into clean, semantic HTML/CSS",
  "author": {
    "name": "Draw-to-Web Team"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:dir": "electron-vite build && electron-builder --dir",
    "compile": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:a11y": "vitest run tests/a11y",
    "lint": "eslint . --ext .ts,.tsx && prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "audit:sample": "vite-node scripts/emit-runtime-audit-sample.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axe-core": "^4.8.3",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "immer": "^11.1.8",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "konva": "^9.3.3",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "radash": "^12.1.1",
    "react": "^19.2.6",
    "react-arborist": "^3.8.0",
    "react-colorful": "^5.7.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.2",
    "react-hotkeys-hook": "^5.3.2",
    "react-konva": "^18.2.10",
    "react-resizable-panels": "^4.11.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^4.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.2",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.11.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.32.0",
    "prettier": "^3.2.4",
    "terser": "^5.48.0",
    "typescript": "~5.3.3",
    "vitest": "^1.2.2"
  }
}
