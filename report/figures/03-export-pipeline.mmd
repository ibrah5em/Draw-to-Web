%% Draw-to-Web — export pipeline (src/export/index.ts exportProject)
flowchart TD
  DOC["Document (current editor state)"] --> V["1. validate<br/>validateDocument(doc)"]
  V -- "errors &gt; 0" --> STOP(["Export blocked<br/>(Problems panel)"])
  V -- "ok" --> G["2. generate<br/>emitHtml / emitCss / emitJs -> prettier"]
  G --> S["3. inject-seo<br/>head + Open Graph + JSON-LD + ARIA landmark roles"]
  S --> A["4. a11y-gate<br/>axe-core in jsdom"]
  A -- "critical / serious" --> STOP
  A -- "pass" --> O["5. optimize-images<br/>read WebP/SVG variants via IPC"]
  O --> M["6. minify (optional)<br/>lightningcss + terser + html-minifier-terser"]
  M --> SR["7. sitemap-robots<br/>sitemap.xml + robots.txt"]
  SR --> B["8. bundle<br/>JSZip -> ArrayBuffer"]
  B --> SV["9. save<br/>IPC -> main -> fs.writeFile"]
  SV --> OUT(["project.zip<br/>index.html, styles.css, scripts.js,<br/>assets/*, sitemap.xml, robots.txt"])

  G -. "tag = element.semanticRole ?? div" .-> NOTE["Semantic roles come from the<br/>document tree (presets); inferSemantics<br/>annotates only the live canvas"]
