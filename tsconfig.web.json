{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@store/*": ["./src/store/*"],
      "@engine/*": ["./src/engine/*"],
      "@generator/*": ["./src/generator/*"],
      "@seo/*": ["./src/seo/*"],
      "@export/*": ["./src/export/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/store/**/*",
    "src/engine/**/*",
    "src/generator/**/*",
    "src/seo/**/*",
    "src/export/**/*",
    "src/shared/**/*"
  ]
}
