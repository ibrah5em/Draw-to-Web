exports[`generate(document) > matches the snapshot (catches accidental output drift) 1`] = `
{
  "css": "*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  text-size-adjust: 100%;
}

body {
  min-height: 100vh;
  line-height: 1.5;
  font-family: var(--font-family-body, system-ui, sans-serif);
}

img,
picture,
svg,
video {
  display: block;
  max-width: 100%;
}

button,
input,
select,
textarea {
  font: inherit;
  color: inherit;
}

a {
  color: inherit;
}

:root {
  --color-bg: #ffffff;
  --color-text: #111111;
  --color-accent: #0066ff;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 32px;
  --font-size-body: clamp(14px, 1rem + 0.2vw, 18px);
  --font-size-h1: clamp(28px, 2rem + 2vw, 56px);
  --font-family-body: system-ui, sans-serif;
  --radius-sm: 4px;
}

:root[data-theme="dark"] {
  --color-bg: #0b0b10;
  --color-text: #f5f5f5;
  --color-accent: #5599ff;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    --color-bg: #0b0b10;
    --color-text: #f5f5f5;
    --color-accent: #5599ff;
  }
}

.dtw-el-root {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding-top: var(--space-lg);
  padding-right: var(--space-md);
  padding-bottom: var(--space-lg);
  padding-left: var(--space-md);
  background-color: var(--color-bg);
}

.dtw-el-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.dtw-el-title {
  font-family: var(--font-family-body);
  font-size: var(--font-size-h1);
  color: var(--color-text);
}

.dtw-el-cta {
  padding-top: var(--space-sm);
  padding-right: var(--space-md);
  padding-bottom: var(--space-sm);
  padding-left: var(--space-md);
  background-color: var(--color-accent);
  border-radius: var(--radius-sm);
  color: var(--color-bg);
}

.dtw-el-hero {
  width: 100%;
  max-width: 720px;
  border-radius: var(--radius-sm);
}

.dtw-el-divider {
  margin-top: var(--space-md);
  margin-bottom: var(--space-md);
}

.dtw-el-skills {
  font-family: var(--font-family-body);
  color: var(--color-text);
}

.dtw-el-footer {
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.dtw-el-footer-text {
  color: var(--color-text);
}

.dtw-el-cta:hover {
  opacity: 0.85;
}

@media (max-width: 768px) {
  .dtw-el-root {
    padding-top: var(--space-md);
    padding-right: var(--space-sm);
    padding-bottom: var(--space-md);
    padding-left: var(--space-sm);
  }
}
",
  "html": "<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <main class="dtw-el-root">
      <header class="dtw-el-header">
        <h1 class="dtw-el-title">Welcome, Ada Lovelace</h1>
        <a class="dtw-el-cta" href="#contact" target="_blank" rel="noopener noreferrer"
          >Contact me</a
        >
      </header>
      <img
        class="dtw-el-hero"
        src="https://example.com/photo.jpg"
        alt="A photo of the author at their desk"
        loading="lazy"
        decoding="async"
      />
      <hr class="dtw-el-divider" />
      <ul class="dtw-el-skills">
        <li>TypeScript</li>
        <li>React</li>
        <li>Electron</li>
      </ul>
      <footer class="dtw-el-footer">
        <p class="dtw-el-footer-text">© 2026 Ada Lovelace</p>
      </footer>
    </main>
  </body>
</html>
",
  "js": "",
}
