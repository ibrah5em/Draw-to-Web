exports[`CanvasNode > renders the portfolio fixture tree without errors 1`] = `"<main style="display:flex;flex-direction:column" data-dtw-id="root"><header style="display:flex;flex-direction:row;justify-content:space-between;align-items:center" data-dtw-id="header"><h1 data-dtw-id="title">Welcome, {{name}}</h1><a href="#contact" target="_blank" data-dtw-id="cta">Contact me</a></header><img style="width:100%;max-width:720px" data-dtw-id="hero" src="https://example.com/photo.jpg" alt="A photo of the author at their desk"/><hr data-dtw-id="divider"/><ul data-dtw-id="skills"><li>TypeScript</li><li>React</li><li>Electron</li></ul><footer style="display:flex;flex-direction:row;justify-content:center" data-dtw-id="footer"><p data-dtw-id="footer-text">© 2026 {{name}}</p></footer></main>"`;
