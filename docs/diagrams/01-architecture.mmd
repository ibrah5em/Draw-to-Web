%% Draw-to-Web — high-level architecture (Electron main / preload / renderer / preview)
flowchart LR
  subgraph Renderer["Renderer process (React UI)"]
    UI["UI layer<br/>Canvas - Panels - Topbar - Dialogs"]
    STORE["Zustand stores<br/>document / history / session / viewPrefs"]
    GEN["Generator + Export<br/>HTML / CSS / JS"]
  end

  subgraph Preload["Preload (sandboxed bridge)"]
    API["window.electronAPI<br/>typed, wrapped methods only"]
  end

  subgraph Main["Electron main process"]
    LC["App lifecycle<br/>BrowserWindow"]
    IPC["IPC handlers<br/>ipcMain.handle"]
    SHARP["Image pipeline<br/>sharp to WebP"]
    PROTO["dtw-asset:// protocol<br/>serves uploaded images"]
    MIN["Minifiers<br/>lightningcss / terser"]
    FILES["Native file ops<br/>open / save .dtw, write .zip"]
  end

  PREVIEW["Live Preview window<br/>BrowserWindow (about:blank)"]

  UI <-->|"read selectors / dispatch ops"| STORE
  STORE -->|"generate(doc)"| GEN
  UI -->|"invoke"| API
  GEN -->|"invoke"| API
  API <-->|"ipcRenderer <-> ipcMain"| IPC
  IPC --> SHARP
  IPC --> MIN
  IPC --> FILES
  IPC --> PREVIEW
  PROTO -. "serves image bytes" .-> UI
  GEN -->|"updatePreview(html, css)"| PREVIEW
